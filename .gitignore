# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
!/tmp/pids/.keep
!/tmp/storage/.keep
tmp/cache/bootsnap/*

# Ignore storage
/storage/*
!/storage/.keep
/storage/test.sqlite3

# Ignore master key
/config/master.key
/config/credentials/*.key
