<% content_for :title, "Histórico da Catraca #{@catraca.nome}" %>

<main class="history-page">
  <section class="history-heading">
    <div>
      <p class="eyebrow">Histórico local</p>
      <h1>Histórico da <%= @catraca.nome %></h1>
      <p class="history-subtitle">
        <%= @catraca.restaurante.nome %> · Piso <%= @catraca.piso %> ·
        <span class="status status-<%= @catraca.status %>"><i></i><%= @catraca.status.humanize %></span>
      </p>
    </div>
    <%= link_to "Registrar acesso", new_catraca_acesso_path(@catraca), class: "button button-primary" %>
  </section>

  <section class="history-metrics" aria-label="Resumo de hoje">
    <article class="history-metric">
      <span class="metric-label">Passagens liberadas hoje</span>
      <strong><%= @giros %></strong>
      <small>Registros confirmados</small>
    </article>
    <article class="history-metric">
      <span class="metric-label">Registros hoje</span>
      <strong><%= @registros_hoje %></strong>
      <small>Acessos nesta catraca</small>
    </article>
    <article class="history-metric">
      <span class="metric-label">Total debitado hoje</span>
      <strong><%= number_to_currency(@total_debito, unit: "R$ ") %></strong>
      <small>Somente passagens liberadas</small>
    </article>
  </section>

  <section class="history-records">
    <%= form_with url: catraca_acessos_path(@catraca), method: :get, class: "history-filters" do |form| %>
      <div>
        <%= form.label :data, "Data" %>
        <%= form.date_field :data, value: params[:data] %>
      </div>
      <div>
        <%= form.label :turno, "Turno" %>
        <%= form.select :turno,
                        options_for_select(["Café da manhã", "Almoço", "Jantar"], params[:turno]),
                        include_blank: "Todos" %>
      </div>
      <div>
        <%= form.label :status, "Status do acesso" %>
        <%= form.select :status,
                        options_for_select(Acesso.status_acessos.keys.map { |status| [status.humanize, status] }, params[:status]),
                        include_blank: "Todos" %>
      </div>
      <div>
        <%= form.label :modo, "Modo de validação" %>
        <%= form.text_field :modo, value: params[:modo], placeholder: "Ex.: Cartão" %>
      </div>
      <div class="history-filter-actions">
        <%= form.submit "Filtrar", class: "button button-primary" %>
        <%= link_to "Limpar", catraca_acessos_path(@catraca), class: "button button-secondary" %>
      </div>
    <% end %>

    <% if @acessos.any? %>
      <div class="history-table-wrap">
        <table class="history-table">
          <thead>
            <tr>
              <th>Horário</th>
              <th>Matrícula</th>
              <th>Modo</th>
              <th>Turno</th>
              <th>Tarifa</th>
              <th>Status do acesso</th>
              <th>Status da catraca</th>
              <th>Motivo</th>
            </tr>
          </thead>
          <tbody>
            <% @acessos.each do |acesso| %>
              <tr class="access-row-<%= acesso.status_acesso %>">
                <td><%= l(acesso.ocorrido_em, format: "%H:%M · %d/%m/%Y") %></td>
                <td><%= acesso.matricula_discente %></td>
                <td><%= acesso.modo_validacao %></td>
                <td><%= acesso.turno %></td>
                <td><%= number_to_currency(acesso.tarifa, unit: "R$ ") %></td>
                <td><span class="access-status"><%= acesso.status_acesso.humanize %></span></td>
                <td><%= acesso.status_catraca.humanize %></td>
                <td><%= acesso.motivo_negativa.presence || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="history-empty">
        <strong>Nenhum acesso encontrado</strong>
        <span>Altere os filtros ou limpe a busca para ver outros registros.</span>
      </div>
    <% end %>
  </section>

  <%= link_to "Voltar aos restaurantes", restaurantes_path, class: "history-back" %>
</main>
