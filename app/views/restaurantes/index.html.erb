<% content_for :title, "Gestão de Restaurantes" %>

<main class="management-page">
  <div class="management-heading">
    <div>
      <h1>Gestão de Restaurantes e Catracas</h1>
    </div>
  </div>

  <div class="management-actions">
    <%= link_to new_restaurante_path, class: "button button-secondary" do %>
      <span aria-hidden="true">＋</span> Cadastrar restaurante
    <% end %>
  </div>

  <section class="metrics-grid" aria-label="Resumo">
    <article class="metric-card">
      <div>
        <span class="metric-label">Total de restaurantes</span>
        <strong><%= @restaurantes.count %> <%= @restaurantes.count == 1 ? "Unidade" : "Unidades" %></strong>
        <% if @restaurantes.any? %>
          <small><%= @restaurantes.first.campus.presence || "Campus não informado" %></small>
        <% end %>
      </div>
      <span class="metric-icon" aria-hidden="true">♜</span>
    </article>

    <article class="metric-card">
      <div>
        <span class="metric-label">Catracas cadastradas</span>
        <strong><%= @total_catracas %> <%= @total_catracas == 1 ? "Catraca" : "Catracas" %></strong>
        <small><%= @restaurantes.count %> <%= @restaurantes.count == 1 ? "restaurante" : "restaurantes" %></small>
      </div>
      <span class="metric-icon" aria-hidden="true">◉</span>
    </article>

    <article class="metric-card">
      <div>
        <span class="metric-label">Pisos cadastrados</span>
        <strong><%= @total_pisos %> <%= @total_pisos == 1 ? "Piso" : "Pisos" %></strong>
        <small>Distribuição das unidades</small>
      </div>
      <span class="metric-icon" aria-hidden="true">▦</span>
    </article>
  </section>

  <section class="units-section">
    <div class="section-title">
      <h2>Unidades cadastradas</h2>
      <span><%= @restaurantes.count %> <%= @restaurantes.count == 1 ? "unidade operacional" : "unidades operacionais" %></span>
    </div>

    <% if @restaurantes.any? %>
      <% @restaurantes.each do |restaurante| %>
        <article class="unit-card">
          <header class="unit-header">
            <div class="unit-name">
              <span class="unit-badge"><%= restaurante.id %></span>
              <div>
                <div class="unit-title">
                  <h3><%= restaurante.nome %></h3>
                  <% if restaurante.campus.present? %>
                    <span><%= restaurante.campus %></span>
                  <% end %>
                </div>
                <p>
                  Capacidade: <strong><%= number_with_delimiter(restaurante.capacidade_por_hora) %> ref/hora</strong>
                  · <%= pluralize(restaurante.catracas.size, "catraca") %>
                </p>
              </div>
            </div>
            <div class="unit-actions">
              <%= link_to "Editar unidade", edit_restaurante_path(restaurante), class: "button button-small button-secondary" %>
              <%= link_to "Adicionar catraca", new_restaurante_catraca_path(restaurante), class: "button button-small button-primary" %>
              <%= button_to "Remover", restaurante_path(restaurante), method: :delete, class: "button button-small button-danger" %>
            </div>
          </header>

          <div class="floors">
            <% catracas_por_piso = restaurante.catracas.group_by(&:piso) %>
            <% (1..restaurante.total_pisos).each do |piso| %>
              <div class="floor-group">
                <h4>Piso <%= piso %></h4>
                <div class="turnstile-grid">
                  <% catracas_piso = catracas_por_piso.fetch(piso, []) %>
                  <% if catracas_piso.any? %>
                    <% catracas_piso.each do |catraca| %>
                      <div class="turnstile-card">
                        <div>
                          <strong><%= catraca.nome %></strong>
                          <span class="status status-<%= catraca.status %>"><i></i><%= catraca.status.humanize %></span>
                        </div>
                        <div class="turnstile-actions">
                          <%= link_to "Editar", edit_catraca_path(catraca) %>
                          <%= link_to "Histórico", catraca_acessos_path(catraca) %>
                          <%= button_to "Remover", catraca_path(catraca), method: :delete, class: "text-danger" %>
                        </div>
                      </div>
                    <% end %>
                  <% else %>
                    <p class="no-turnstile">Nenhuma catraca neste piso.</p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </article>
      <% end %>
    <% else %>
      <div class="empty-state">
        <strong>Nenhum restaurante cadastrado.</strong>
        <%= link_to "Cadastrar primeiro restaurante", new_restaurante_path, class: "button button-primary" %>
      </div>
    <% end %>
  </section>
</main>