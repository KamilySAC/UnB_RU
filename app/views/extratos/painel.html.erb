<h1>Meus gastos</h1>

<nav id="abas">
  <%= link_to 'Recargas',  painel_path(aba: 'recargas')  %>
  <%= link_to 'Refeições', painel_path(aba: 'refeicoes') %>
</nav>

<% if @aba == 'refeicoes' %>
  <% if @refeicoes.empty? %>
    <p>Nenhuma refeição encontrada no período</p>
  <% else %>
    <table id="tabela_refeicoes">
      <thead><tr><th>Data</th><th>Restaurante</th><th>Valor</th></tr></thead>
      <tbody>
        <% @refeicoes.each do |r| %>
          <tr>
            <td><%= r.data.strftime('%d/%m/%Y') %></td>
            <td><%= r.restaurante %></td>
            <td>R$ <%= format('%.2f', r.valor) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
  <p id="total">Total gasto: R$ <%= format('%.2f', @total_refeicoes) %></p>
<% else %>
  <% if @recargas.empty? %>
    <p>Nenhuma recarga encontrada no período</p>
  <% else %>
    <table id="tabela_recargas">
      <thead><tr><th>Data</th><th>Valor</th><th>Forma</th><th>Status</th></tr></thead>
      <tbody>
        <% @recargas.each do |r| %>
          <tr>
            <td><%= r.data.strftime('%d/%m/%Y') %></td>
            <td>R$ <%= format('%.2f', r.valor) %></td>
            <td><%= r.forma %></td>
            <td><%= r.status %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
  <p id="total">Total recarregado: R$ <%= format('%.2f', @total_recargas) %></p>
<% end %>
